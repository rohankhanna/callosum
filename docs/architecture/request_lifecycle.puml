@startuml request_lifecycle
' Callosum request lifecycle — what happens between a client POST and
' the streamed response, including the parts the operator surfaces in
' callosum-ctl / snorkel / /events/routing care about.
'
' This is a sequence at the process-internal level — not API contracts.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam shadowing false
skinparam sequence {
  ArrowColor #444444
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFE4B5
  ParticipantFontColor #000000
}

participant "Client" as C
participant "FastAPI\napp.py" as App
participant "Router\nrouting/*" as R
participant "Capability\nFilter" as CF
participant "Selector" as S
participant "Backend\n(picked cell)" as B
participant "Upstream\n(cloud or local)" as U
participant "Usage\nLog" as UL
participant "Peer Quality\nMatrix" as PQ
participant "PeerJudgeLabeler\n(shadow job)" as PJ
database "operator_state\n.sqlite" as OS

C -> App : POST /v1/responses (stream)
App -> OS : get_mode() + denylist
App -> R : route(body, cells_after_mode_filter)
R -> R : extract_features(body)\n(tokens, modalities, needs_tools)
R -> CF : filter(cells, features)
CF --> R : compatible cells
R -> R : predict(features, compatible)\n(uniform | cell_majority_prior)
R -> S : select(scaled_predictions, capabilities)\n(cost_rank compatibility rank;\nbackend routing uses composite\n5h + weekly quota pressure)
S --> R : chosen cell + ranked candidates
R --> App : RoutingDecision

note right of App
  Minimum-coverage quota:
  on a non-hard text turn,
  if a compatible cell is
  below its even-split floor,
  steer to the least-sampled
  eligible cell (feasibility-
  filtered). Gated by
  min_coverage_quota_enabled.
  Organic traffic keeps the
  cost/quality-optimal pick.
end note

note right of App
  Cell-retry walks
  candidates on 5xx
  (not on 4xx).
end note

App -> B : responses_stream(body)
B -> U : POST /responses or /v1/chat/completions
U --> B : SSE event stream
B -> B : ResponsesStreamCollector\ntees bytes for usage parse
B --> App : SSE bytes (forwarded)
App --> C : SSE bytes (yielded as they arrive)

note over B
  Backend sets
  handle.stream_summary
  after stream end.
end note

B --> App : stream complete
App -> UL : record(UsageLogEntry)\n(tokens parsed from response.completed)

opt peer-quality sidecar judge (primary; on by default)
  App -> App : _spawn_sidecar_judge()\nafter response completes;\nbest-effort, no client latency
  App -> UL : select_unjudged_cross_cell_subject()\nprior same-session turn from a different cell
  UL --> App : subject request/response text\n+ served cell
  App -> U : judge request (out-of-band)\nvia the same backend
  U --> App : judgement
  App -> UL : record_peer_quality_opinions()\n(judge cell to subject cell)
end

opt legacy in-band <<qop>> capture (opt-in; CALLOSUM_PEER_QUALITY_INBAND_ENABLED=1, default off)
  App -> App : modify outbound body with\nnonce audit instruction
  App -> B : modified outbound body
  App -> PQ : parse nonce-bound <<qop ...>>\nstrip echoes/malformed markers
  PQ -> UL : record_peer_quality_opinions()\n(judge cell to subject cell)
  PQ -> UL : record_peer_quality_capture_metrics()\n(valid/echo/malformed counts)
end

opt offline peer-label shadow pass
  PJ -> UL : read peer_quality_opinions\nprefer exact subject_request_id;\nlegacy fallback to latest prior\nsame-session subject cell
  PJ -> UL : write quality_score +\nquality_label_method=peer_quality_v1\nonly for unlabeled rows
end

note right of UL
  usage_log.record() triggers
  /events/routing broadcaster
  notify() → snorkel sidecar
  HUD updates in real time.
end note

App -> App : CostUsageEstimator.finalize()\n(realized weekly-quota delta;\n0 delta = verifiable=false →\naggregate calibration only)
App -> App : TimeUsageEstimator.finalize()\n(realized latency_ms; local NOT 0,\nalways verifiable; fit t≈a·in+b·out+c\nfor pre-flight ETA + timeout tuning)

@enduml
