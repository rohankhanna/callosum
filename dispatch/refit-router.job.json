{
  "job_name": "codex-proxy-refit-router",
  "workflow_preset": "direct",
  "device_preference": "cpu",
  "payload": {
    "argv": [
      "/usr/bin/curl",
      "-fsS",
      "-X", "POST",
      "http://127.0.0.1:8765/control/refit-router"
    ]
  },
  "resources": {
    "graphics_processing_units": 0,
    "central_processing_unit_cores": 1,
    "memory_gibibytes": 1
  },
  "schedule": {
    "kind": "recurring",
    "interval_seconds": 3600
  },
  "dependencies": {
    "parents": [],
    "policy": "afterok"
  },
  "retry_policy": {
    "max_attempts": 3,
    "backoff_seconds": 60
  },
  "drain_behavior": "wait"
}
